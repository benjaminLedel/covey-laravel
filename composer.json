{
    "name": "benjaminledel/covey-laravel",
    "description": "Give a covey agent (covey.work) a door into your Laravel application: schema, read-only queries and the application log behind a read token, tinker behind a write token, so writes carry their own guard rails.",
    "type": "library",
    "license": "MIT",
    "keywords": ["covey", "laravel", "agent", "ai-agent", "tinker", "logs", "support"],
    "homepage": "https://covey.work",
    "support": {
        "docs": "https://covey.work/docs",
        "source": "https://github.com/benjaminLedel/covey-laravel",
        "issues": "https://github.com/benjaminLedel/covey-laravel/issues"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/console": "^12.0",
        "psy/psysh": "^0.12"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "Covey\\Laravel\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Covey\\Laravel\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Covey\\Laravel\\CoveyServiceProvider"]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
